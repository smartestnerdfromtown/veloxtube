{
  "manifest_version": 3,
  "name": "VeloxTube",
  "version": "0.0.0",
  "description": "Hyper-minimal YouTube cleanifier for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "veloxtube@veloxtube.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
