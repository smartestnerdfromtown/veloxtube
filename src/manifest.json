{
  "manifest_version": 3,
  "name": "VeloxTube",
  "version": "0.0.0",
  "description": "Minimal YouTube cleanifier for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "veloxtube@veloxtube.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "VeloxTube",
    "default_popup": "popup/index.html",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/index.js"],
      "css": ["styles/inject.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background/index.js"]
  }
}
