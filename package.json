{
  "name": "veloxtube",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hyper-minimal YouTube cleanifier for Firefox.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/content.ts --bundle --minify --target=firefox115 --outfile=dist/content.js && cp src/manifest.json src/veloxtube.css dist/",
    "watch": "esbuild src/content.ts --bundle --target=firefox115 --outfile=dist/content.js --sourcemap --watch",
    "lint": "web-ext lint --source-dir=dist",
    "dev": "npm run build && web-ext run --source-dir=dist --browser-console"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "web-ext": "^10.8.0"
  }
}
